<phone:PhoneApplicationPage
    x:Class="Store_Patcher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <!-- One screen on purpose: what is on the device, what this app can do, what it
         did, and the reboot it may need. Everything else is in the log below. -->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,17,0,8">
            <TextBlock Text="STORE PATCHER" Style="{StaticResource PhoneTextNormalStyle}" Margin="12,0"/>
            <TextBlock Text="device patcher" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12,0,12,0">
            <!-- The status card is the way into the certificate and lab details: what
                 the CA is, which address answers for the Store names, and what has to
                 be imported for the device to trust it. -->
            <Border x:Name="StatusCard" Background="#22FFFFFF" Padding="8"
                    MouseLeftButtonUp="OnStatusTapped">
                <StackPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource PhoneTextNormalStyle}"/>
                    <TextBlock x:Name="StateText" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="22" Foreground="{StaticResource PhoneAccentBrush}"/>
                    <TextBlock x:Name="TapHint" Text="tap for certificate and lab details" Margin="0,6,0,0"
                               FontSize="18" Style="{StaticResource PhoneTextSubtleStyle}"/>
                    <!-- The verdict that matters. The registry check above cannot work on this
                         build, so whether the phone trusts the CA is answered by using it: a
                         completed TLS handshake to a name the lab hijacks. -->
                    <TextBlock x:Name="TrustText" Text="lab trust: not tested yet" Margin="0,8,0,0"
                               TextWrapping="Wrap" FontSize="19"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="4,8,4,0">
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap" FontSize="19"/>

                <!-- The authorities, one per line: the one embedded in this build come
                     first, then anything pushed into isolated storage. Selecting one
                     shows its DNS address - which is the question this whole screen
                     exists to answer. -->
                <TextBlock Text="CERTIFICATE AUTHORITIES - TAP ONE TO SELECT" Margin="0,12,0,4"
                           FontSize="17" Style="{StaticResource PhoneTextSubtleStyle}"/>
                <ListBox x:Name="CertificateList" MaxHeight="280"
                         SelectionChanged="OnCertificateSelected"/>
                <TextBlock x:Name="CertificateDetail" TextWrapping="Wrap" FontSize="19"
                           Margin="4,4,4,0"/>
            </StackPanel>

            <Button x:Name="CheckButton" Content="check device state" Click="OnCheckDevice"/>
            <Button x:Name="ProbeButton" Content="test capabilities" Click="OnProbe"/>
            <Button x:Name="TrustButton" Content="check lab trust" Click="OnTrust"/>
            <Button x:Name="RunbookButton" Content="how to install it here" Click="OnRunbook"/>
            <Button x:Name="CopyButton" Content="copy the import line" IsEnabled="False" Click="OnCopyImportLine"/>
            <Button x:Name="ApplyButton" Content="apply patches" Click="OnApply"/>
            <Button x:Name="RebootButton" Content="reboot phone" IsEnabled="False" Click="OnReboot"/>

            <TextBlock x:Name="RebootText" Text="reboot required" Visibility="Collapsed"
                       Margin="0,8,0,0" FontSize="26" Style="{StaticResource PhoneTextSubtleStyle}"/>
        </StackPanel>

        <ListBox x:Name="LogList" Grid.Row="2" Margin="6,0,6,0"/>
    </Grid>

</phone:PhoneApplicationPage>
